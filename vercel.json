{
  "framework": "vite",
  "buildCommand": "cd orbital-harmony-app && npm run build",
  "outputDirectory": "orbital-harmony-app/dist",
  "installCommand": "cd orbital-harmony-app && npm ci",
  "functions": {
    "api/trivia.mjs": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
